# PubMed / NCBI E-utilities key — optional; lifts the shared-IP rate limit.
NCBI_API_KEY=

# Postgres "memory" layer (Phase 1). OPTIONAL: when unset, the app falls back to
# the live fan-out and works exactly as before. When set, reads come from the store
# (instant, immune to upstream outages). Use a pooled connection string on serverless
# (Neon/Supabase pooler, or Vercel Postgres).
DATABASE_URL=

# Token guarding POST /api/admin/ingest (materialise plants into the store).
ADMIN_TOKEN=
